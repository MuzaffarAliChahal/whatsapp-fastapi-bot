# From Meta for Developers > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=EAAG...your-access-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# App settings > Basic > App secret (used to verify webhook signatures)
WHATSAPP_APP_SECRET=your-app-secret
# Any string; enter the same value when you register the webhook in Meta
WHATSAPP_VERIFY_TOKEN=choose-a-random-string

BUSINESS_NAME=Acme Store
BUSINESS_HOURS=Mon-Sat, 9:00 to 18:00 (PKT)
